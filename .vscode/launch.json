{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SteamRip.App",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/src/SteamRip.App/SteamRip.App.csproj",
      "args": [
        "--show",
        "--verbose"
      ],
      "env": {
        "XDG_CONFIG_HOME": "/tmp/sr-cfg",
        "XDG_DATA_HOME": "/tmp/sr-data"
      }
    },
    {
      "name": "ReSharper: .NET Core / .NET 5+ Executable",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/SteamRip.App/bin/Debug/net10.0/linux-x64/steamrip-desktop.dll",
      "cwd": "${workspaceFolder}/src/SteamRip.App",
      "args": [
        "--show",
        "--verbose"
      ],
      "env": {
        "XDG_CONFIG_HOME": "/tmp/sr-cfg",
        "XDG_DATA_HOME": "/tmp/sr-data"
      },
      "preLaunchTask": "ReSharper: Build"
    },
    {
      "name": "ReSharper: .NET Core / .NET 5+ Attach",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:resharper.debugger.pickProcess.coreclr}"
    }
  ]
}
