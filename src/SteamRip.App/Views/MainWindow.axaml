<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SteamRip.App.ViewModels"
    x:Class="SteamRip.App.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    Title="SteamRIP Desktop"
    Width="1040"
    Height="700"
    MinWidth="820"
    MinHeight="520"
    Icon="avares://steamrip-desktop/Assets/app.png"
>
    <Window.DataTemplates>
        <!-- ============ LAUNCH TWEAKS (shared by Settings defaults and the per-game flyout) ============ -->
        <DataTemplate DataType="vm:LaunchOptionsEditor">
            <StackPanel Spacing="8">
                <TextBlock
                    Classes="muted"
                    TextWrapping="Wrap"
                    Text="Only the environment and wrapper apply on Windows; the rest is for Proton on Linux."
                    IsVisible="{Binding !IsLinux}"
                />
                <UniformGrid Columns="2" IsEnabled="{Binding IsLinux}">
                    <CheckBox Content="{Binding MangoHudLabel}" IsChecked="{Binding MangoHud}" />
                    <CheckBox Content="{Binding GameModeLabel}" IsChecked="{Binding GameMode}" />
                    <CheckBox Content="{Binding GamescopeLabel}" IsChecked="{Binding Gamescope}" />
                    <CheckBox Content="{Binding HdrLabel}" IsChecked="{Binding Hdr}" />
                    <CheckBox Content="{Binding WaylandLabel}" IsChecked="{Binding Wayland}" />
                    <CheckBox Content="{Binding FsrLabel}" IsChecked="{Binding Fsr}" />
                    <CheckBox Content="{Binding FsyncLabel}" IsChecked="{Binding Fsync}" />
                    <CheckBox
                        Content="{Binding ProtonLogLabel}"
                        IsChecked="{Binding ProtonLog}"
                        ToolTip.Tip="PROTON_LOG=1: Wine writes its debug channels to a file in your home directory. Turn it on when a game does not start, then look for err:, 'unimplemented function' or 'Unhandled exception'."
                    />
                </UniformGrid>
                <TextBlock
                    Classes="amber"
                    TextWrapping="Wrap"
                    Text="{Binding HdrWarning}"
                    IsVisible="{Binding HasHdrWarning}"
                />
                <Grid ColumnDefinitions="*,12,*" IsEnabled="{Binding IsLinux}">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Classes="eyebrow" Text="GAMESCOPE ARGUMENTS" />
                        <TextBox
                            Text="{Binding GamescopeArgs}"
                            PlaceholderText="{Binding GamescopeArgsPlaceholder}"
                            FontFamily="{StaticResource Mono}"
                            FontSize="12"
                        />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Classes="eyebrow" Text="MANGOHUD CONFIG" />
                        <TextBox
                            Text="{Binding MangoHudConfig}"
                            PlaceholderText="{Binding MangoHudConfigPlaceholder}"
                            FontFamily="{StaticResource Mono}"
                            FontSize="12"
                        />
                    </StackPanel>
                </Grid>
                <TextBlock Classes="eyebrow" Text="DLL OVERRIDES" IsVisible="{Binding IsLinux}" />
                <TextBox
                    Text="{Binding DllOverrides}"
                    PlaceholderText="{Binding DllOverridesPlaceholder}"
                    FontFamily="{StaticResource Mono}"
                    FontSize="12"
                    IsVisible="{Binding IsLinux}"
                />
                <TextBlock
                    Classes="eyebrow"
                    Text="ENVIRONMENT (KEY=VALUE PER LINE, APPLIED LAST)"
                />
                <TextBox
                    Text="{Binding Environment}"
                    PlaceholderText="{Binding EnvironmentPlaceholder}"
                    AcceptsReturn="True"
                    MinHeight="64"
                    FontFamily="{StaticResource Mono}"
                    FontSize="12"
                />
                <TextBlock Classes="eyebrow" Text="WRAPPER COMMAND" />
                <TextBox
                    Text="{Binding Wrapper}"
                    PlaceholderText="{Binding WrapperPlaceholder}"
                    FontFamily="{StaticResource Mono}"
                    FontSize="12"
                />
                <Button
                    Classes="quiet"
                    Content="Back to Settings defaults"
                    Command="{Binding ResetCommand}"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding IsPerGame}"
                />
            </StackPanel>
        </DataTemplate>

        <!-- ============ LIBRARY ============ -->
        <DataTemplate DataType="vm:LibraryViewModel">
            <DockPanel Margin="28,24,28,20">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Classes="eyebrow" Text="YOUR GAMES" />
                    <DockPanel>
                        <TextBlock Classes="h1" Text="Library" />
                        <Border
                            Classes="pill amber"
                            Margin="12,6,0,0"
                            IsVisible="{Binding UpdatesAvailable}"
                        >
                            <TextBlock FontSize="11">
                                <Run Text="{Binding UpdatesAvailable}" />
                                <Run Text=" update(s) pending" />
                            </TextBlock>
                        </Border>
                    </DockPanel>
                </StackPanel>
                <TextBlock
                    DockPanel.Dock="Top"
                    Classes="muted"
                    IsVisible="{Binding IsEmpty}"
                    TextWrapping="Wrap"
                    Text="Nothing installed yet. Pick a game under Browse; it downloads, verifies, extracts into your library folder, gets its own Proton prefix on first launch, and stays current from then on."
                />
                <TextBlock
                    DockPanel.Dock="Top"
                    Classes="red"
                    Margin="0,0,0,10"
                    TextWrapping="Wrap"
                    Text="{Binding LastError}"
                    IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                />
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:LibraryItem">
                                <Border Classes="card" Margin="0,0,0,8">
                                    <Grid
                                        ColumnDefinitions="Auto,*,Auto"
                                        RowDefinitions="Auto,Auto,Auto"
                                    >
                                        <Border
                                            Grid.Column="0"
                                            Grid.RowSpan="3"
                                            Classes="cover"
                                            Width="64"
                                            Height="96"
                                            Margin="0,0,14,0"
                                        >
                                            <Panel>
                                                <TextBlock
                                                    Classes="coverInitial"
                                                    Text="{Binding Initial}"
                                                    IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNull}}"
                                                />
                                                <Image
                                                    Source="{Binding Cover}"
                                                    Stretch="UniformToFill"
                                                />
                                            </Panel>
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            Grid.Row="0"
                                            Orientation="Horizontal"
                                            Spacing="10"
                                        >
                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontWeight="SemiBold"
                                                FontSize="15"
                                                VerticalAlignment="Center"
                                            />
                                            <Border Classes="pill" IsVisible="{Binding IsRunning}">
                                                <TextBlock
                                                    FontSize="11"
                                                    Classes="green"
                                                    Text="Running"
                                                />
                                            </Border>
                                            <TextBlock
                                                Classes="muted"
                                                Text="{Binding SizeText}"
                                                VerticalAlignment="Center"
                                            />
                                            <TextBlock
                                                Classes="muted"
                                                Text="{Binding Playtime}"
                                                VerticalAlignment="Center"
                                            />
                                        </StackPanel>
                                        <!-- Version ticket: installed → site. The arrow lights amber when they differ. -->
                                        <StackPanel
                                            Grid.Column="1"
                                            Grid.Row="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            Margin="0,4,0,0"
                                        >
                                            <TextBlock
                                                Classes="mono"
                                                Text="{Binding InstalledVersion}"
                                            />
                                            <TextBlock
                                                Classes="mono muted"
                                                Text="→"
                                                IsVisible="{Binding !HasUpdate}"
                                            />
                                            <TextBlock
                                                Classes="mono amber"
                                                Text="→"
                                                IsVisible="{Binding HasUpdate}"
                                            />
                                            <TextBlock
                                                Classes="mono muted"
                                                Text="{Binding SiteVersion}"
                                                IsVisible="{Binding !HasUpdate}"
                                            />
                                            <TextBlock
                                                Classes="mono amber"
                                                Text="{Binding SiteVersion}"
                                                IsVisible="{Binding HasUpdate}"
                                            />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            Grid.Row="2"
                                            Margin="0,6,0,0"
                                            Orientation="Horizontal"
                                            Spacing="10"
                                        >
                                            <TextBlock
                                                Text="{Binding StatusLine}"
                                                TextWrapping="Wrap"
                                                Classes.muted="{Binding !NeedsAttention}"
                                                Classes.red="{Binding NeedsAttention}"
                                                Classes.green="{Binding IsRunning}"
                                            />
                                            <TextBlock
                                                Classes="mono muted"
                                                FontSize="11"
                                                Text="{Binding ExeLine}"
                                                VerticalAlignment="Center"
                                            />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            Grid.Row="0"
                                            Grid.RowSpan="3"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center"
                                        >
                                            <Button
                                                Classes="primary"
                                                Content="Play"
                                                Command="{Binding PlayCommand}"
                                                IsVisible="{Binding !IsRunning}"
                                                IsEnabled="{Binding CanPlay}"
                                                MinWidth="72"
                                            />
                                            <Button
                                                Classes="danger"
                                                Content="Stop"
                                                Command="{Binding StopCommand}"
                                                IsVisible="{Binding IsRunning}"
                                                MinWidth="72"
                                            />
                                            <Button
                                                Classes="quiet"
                                                Content="Update now"
                                                Command="{Binding UpdateNowCommand}"
                                                IsVisible="{Binding HasUpdate}"
                                                IsEnabled="{Binding IsIdle}"
                                                Foreground="{StaticResource Amber}"
                                            />
                                            <Button
                                                Classes="quiet"
                                                Content="Launch options"
                                                Command="{Binding OptionsCommand}"
                                            />
                                            <Button Classes="quiet" Content="⋯">
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuItem
                                                            Header="{Binding AutoLabel}"
                                                            Command="{Binding ToggleAutoCommand}"
                                                        />
                                                        <Separator />
                                                        <MenuItem
                                                            Header="{Binding MenuShortcutLabel}"
                                                            Command="{Binding ToggleMenuShortcutCommand}"
                                                        />
                                                        <MenuItem
                                                            Header="{Binding DesktopShortcutLabel}"
                                                            Command="{Binding ToggleDesktopShortcutCommand}"
                                                        />
                                                        <Separator />
                                                        <MenuItem
                                                            Header="Forget (keep files)"
                                                            Command="{Binding ForgetCommand}"
                                                        />
                                                        <MenuItem
                                                            Classes="danger"
                                                            Header="Uninstall and delete files"
                                                            Command="{Binding DeleteCommand}"
                                                        />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>

        <!-- ============ BROWSE ============ -->
        <DataTemplate DataType="vm:BrowseViewModel">
            <DockPanel Margin="28,24,28,20">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Classes="eyebrow" Text="STEAMRIP.COM CATALOG" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                            <Button
                                Classes="quiet"
                                Content="Sync now"
                                Command="{Binding SyncCommand}"
                            />
                            <Button
                                Classes="quiet"
                                Content="Full re-sync"
                                Command="{Binding FullSyncCommand}"
                                ToolTip.Tip="Re-fetch all ~5,000 posts (about 50 requests)"
                            />
                        </StackPanel>
                        <TextBlock Classes="h1" Text="Browse" />
                    </DockPanel>
                </StackPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel
                        DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        Spacing="6"
                        Margin="8,0,0,0"
                    >
                        <ComboBox
                            ItemsSource="{Binding Genres}"
                            SelectedItem="{Binding Genre}"
                            DisplayMemberBinding="{Binding Name}"
                            MinWidth="170"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Genre (the site's categories)"
                        />
                        <ComboBox
                            ItemsSource="{Binding Sorts}"
                            SelectedItem="{Binding Sort}"
                            DisplayMemberBinding="{Binding Label}"
                            MinWidth="170"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Sort order"
                        />
                    </StackPanel>
                    <TextBox PlaceholderText="Search by name…" Text="{Binding Query}" />
                </DockPanel>
                <TextBlock
                    DockPanel.Dock="Top"
                    Classes="muted"
                    Text="{Binding Summary}"
                    Margin="0,0,0,12"
                />
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:BrowseItem">
                                <Border Classes="card" Margin="0,0,0,6" Padding="16,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border
                                            Grid.Column="0"
                                            Classes="cover"
                                            Width="44"
                                            Height="66"
                                            Margin="0,0,12,0"
                                        >
                                            <Panel>
                                                <TextBlock
                                                    Classes="coverInitial"
                                                    FontSize="18"
                                                    Text="{Binding Initial}"
                                                    IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNull}}"
                                                />
                                                <Image
                                                    Source="{Binding Cover}"
                                                    Stretch="UniformToFill"
                                                />
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    FontWeight="SemiBold"
                                                    FontSize="14"
                                                />
                                                <TextBlock
                                                    Classes="mono muted"
                                                    Text="{Binding Version}"
                                                    VerticalAlignment="Center"
                                                />
                                            </StackPanel>
                                            <TextBlock Classes="muted" Margin="0,3,0,0">
                                                <Run Text="{Binding Size}" />
                                                <Run Text="  ·  updated " />
                                                <Run Text="{Binding Updated}" />
                                                <Run Text="  ·  " />
                                                <Run Text="{Binding Mirrors}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center"
                                        >
                                            <Border Classes="pill" IsVisible="{Binding Installed}">
                                                <TextBlock
                                                    FontSize="11"
                                                    Classes="green"
                                                    Text="In library"
                                                />
                                            </Border>
                                            <Border
                                                Classes="pill"
                                                IsVisible="{Binding Unsupported}"
                                                ToolTip.Tip="This post only has mirrors the app can't resolve (1fichier, FileCrypt…)"
                                            >
                                                <TextBlock
                                                    FontSize="11"
                                                    Classes="muted"
                                                    Text="No supported mirror"
                                                />
                                            </Border>
                                            <Button
                                                Classes="primary"
                                                Content="Install"
                                                Command="{Binding InstallCommand}"
                                                IsVisible="{Binding CanInstall}"
                                            />
                                            <Button
                                                Classes="quiet"
                                                Content="Page"
                                                Command="{Binding OpenPageCommand}"
                                            />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>

        <!-- ============ QUEUE ============ -->
        <DataTemplate DataType="vm:QueueViewModel">
            <DockPanel Margin="28,24,28,20">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Classes="eyebrow" Text="ONE AT A TIME" />
                    <DockPanel>
                        <StackPanel
                            DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center"
                        >
                            <ToggleSwitch
                                IsChecked="{Binding Paused}"
                                OnContent="Auto-updates paused"
                                OffContent="Auto-updates on"
                            />
                            <Button
                                Classes="quiet"
                                Content="Clear finished"
                                Command="{Binding ClearFinishedCommand}"
                            />
                        </StackPanel>
                        <TextBlock Classes="h1" Text="Queue" />
                    </DockPanel>
                </StackPanel>
                <TextBlock
                    DockPanel.Dock="Top"
                    Classes="muted"
                    IsVisible="{Binding IsEmpty}"
                    Text="Nothing queued. Updates land here automatically when the catalog changes; installs when you press Install."
                    TextWrapping="Wrap"
                />
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:JobItem">
                                <Border Classes="card" Margin="0,0,0,8" Padding="0">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,10">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        FontWeight="SemiBold"
                                                        FontSize="15"
                                                    />
                                                    <Border Classes="pill">
                                                        <TextBlock
                                                            FontSize="11"
                                                            Text="{Binding Kind}"
                                                        />
                                                    </Border>
                                                    <TextBlock
                                                        Classes="mono muted"
                                                        Text="{Binding Version}"
                                                        VerticalAlignment="Center"
                                                    />
                                                </StackPanel>
                                                <TextBlock
                                                    Margin="0,6,0,0"
                                                    Text="{Binding Status}"
                                                    TextWrapping="Wrap"
                                                    Classes.muted="{Binding Active}"
                                                    Classes.red="{Binding NeedsAttention}"
                                                    Classes.green="{Binding Done}"
                                                />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center"
                                            >
                                                <Button
                                                    Classes="primary"
                                                    Content="Solve in browser"
                                                    Command="{Binding SolveInBrowserCommand}"
                                                    IsVisible="{Binding NeedsAttention}"
                                                    IsEnabled="{Binding CanSolveInBrowser}"
                                                    ToolTip.Tip="Opens a visible Chromium on the FileDitch mirror so you can pass its check; the download then continues here."
                                                />
                                                <Button
                                                    Classes="quiet"
                                                    Content="Retry"
                                                    Command="{Binding RetryCommand}"
                                                    IsVisible="{Binding Failed}"
                                                />
                                                <Button
                                                    Classes="quiet"
                                                    Content="Retry"
                                                    Command="{Binding RetryCommand}"
                                                    IsVisible="{Binding NeedsAttention}"
                                                />
                                                <Button
                                                    Classes="danger"
                                                    Content="Cancel"
                                                    Command="{Binding CancelCommand}"
                                                    IsVisible="{Binding Active}"
                                                />
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar
                                            Margin="0"
                                            CornerRadius="0,0,8,8"
                                            Value="{Binding Fraction}"
                                            Maximum="1"
                                            IsIndeterminate="{Binding Indeterminate}"
                                            IsVisible="{Binding Active}"
                                        />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>

        <!-- ============ ACTIVITY ============ -->
        <DataTemplate DataType="vm:ActivityViewModel">
            <Grid Margin="28,24,28,20" RowDefinitions="Auto,*,Auto,*">
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Classes="eyebrow" Text="WHAT HAPPENED" />
                    <TextBlock Classes="h1" Text="Activity" />
                </StackPanel>
                <Border Grid.Row="1" Classes="card" Padding="0">
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Events}" Margin="12,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ActivityLine">
                                    <Grid ColumnDefinitions="130,90,*" Margin="0,3">
                                        <TextBlock Classes="mono muted" Text="{Binding When}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Classes="mono"
                                            Text="{Binding Kind}"
                                            Classes.red="{Binding IsError}"
                                            Classes.muted="{Binding !IsError}"
                                        />
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding Message}"
                                            TextWrapping="Wrap"
                                        />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <DockPanel Grid.Row="2" Margin="0,16,0,8">
                    <Button
                        DockPanel.Dock="Right"
                        Classes="quiet"
                        Content="Open log folder"
                        Command="{Binding OpenLogDirCommand}"
                        Padding="10,4"
                        FontSize="12"
                    />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="eyebrow" Text="LOG (THIS SESSION)" />
                        <TextBlock Classes="mono muted" FontSize="11" Text="{Binding LogDir}" />
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="3" Classes="card" Padding="0">
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Live}" Margin="12,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock
                                        Classes="mono muted"
                                        Text="{Binding}"
                                        TextWrapping="Wrap"
                                        Margin="0,1"
                                    />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ============ SETTINGS ============ -->
        <DataTemplate DataType="vm:SettingsViewModel">
            <ScrollViewer>
                <StackPanel
                    Margin="28,24,28,20"
                    Spacing="14"
                    MaxWidth="760"
                    HorizontalAlignment="Left"
                >
                    <StackPanel>
                        <TextBlock Classes="eyebrow" Text="HOW IT RUNS" />
                        <TextBlock Classes="h1" Text="Settings" />
                    </StackPanel>

                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock FontWeight="SemiBold" Text="Folders" />
                            <TextBlock
                                Classes="muted"
                                Text="Games are extracted to &lt;library&gt;/&lt;game-slug&gt;; each gets its own Wine prefix at &lt;game&gt;/prefix on first launch, so saves live with the game and survive updates. Archives land in the downloads folder and are deleted after install unless you say otherwise."
                                TextWrapping="Wrap"
                            />
                            <TextBlock Text="Library folder" Classes="muted" />
                            <TextBox Text="{Binding LibraryRoot}" />
                            <TextBlock Text="Downloads folder" Classes="muted" />
                            <TextBox Text="{Binding DownloadsRoot}" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <StackPanel>
                                    <TextBlock
                                        Text="Save backups to keep per game"
                                        Classes="muted"
                                    />
                                    <NumericUpDown
                                        Value="{Binding KeepBackups}"
                                        Minimum="0"
                                        Maximum="10"
                                        Width="140"
                                    />
                                </StackPanel>
                                <ToggleSwitch
                                    IsChecked="{Binding DeleteArchiveAfterInstall}"
                                    OnContent="Delete archive after install"
                                    OffContent="Keep archive after install"
                                    VerticalAlignment="Bottom"
                                />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock FontWeight="SemiBold" Text="Playing" />
                            <TextBlock
                                Classes="muted"
                                TextWrapping="Wrap"
                                Text="Games run through umu-run with the Proton build below (per-game override in Launch options). GE-Proton and DW-Proton are downloaded on first use and kept current; expect a wait that one time, and the same for umu's runtime."
                            />
                            <TextBlock Text="Default Proton" Classes="muted" />
                            <ComboBox
                                ItemsSource="{Binding Protons}"
                                SelectedItem="{Binding DefaultProton}"
                                HorizontalAlignment="Stretch"
                            />
                            <TextBlock
                                Classes="mono muted"
                                Text="{Binding LauncherLine}"
                                TextWrapping="Wrap"
                            />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock FontWeight="SemiBold" Text="Launch defaults" />
                            <TextBlock
                                Classes="muted"
                                TextWrapping="Wrap"
                                Text="Applied to every game unless its Launch options say otherwise. Missing tools are skipped with a note in the log, never a failed launch. HDR needs a Wayland session and either gamescope or Wine's Wayland driver; the check below tells you which you have."
                            />
                            <ContentControl Content="{Binding Launch}" />
                            <DockPanel Margin="0,6,0,0">
                                <Button
                                    DockPanel.Dock="Right"
                                    Classes="quiet"
                                    Content="Re-check"
                                    Command="{Binding RecheckCommand}"
                                    VerticalAlignment="Top"
                                />
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="eyebrow" Text="CAPABILITY CHECK" />
                                    <TextBlock
                                        Classes="mono muted"
                                        Text="{Binding CapabilityText}"
                                        TextWrapping="Wrap"
                                    />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock FontWeight="SemiBold" Text="Mirrors and Cloudflare" />
                            <TextBlock
                                Classes="muted"
                                TextWrapping="Wrap"
                                Text="FileDitch and BuzzHeavier pages sit behind browser checks; FlareSolverr passes them for you. GoFile and MegaDB need nothing. If every automatic route fails, the queue offers 'Solve in browser'."
                            />
                            <TextBlock Text="FlareSolverr URL" Classes="muted" />
                            <DockPanel>
                                <Button
                                    DockPanel.Dock="Right"
                                    Classes="quiet"
                                    Content="Test"
                                    Command="{Binding TestSolverCommand}"
                                    Margin="6,0,0,0"
                                />
                                <TextBox
                                    Text="{Binding FlareSolverrUrl, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="http://192.168.1.10:8191"
                                    FontFamily="{StaticResource Mono}"
                                    FontSize="12"
                                />
                            </DockPanel>
                            <TextBlock
                                Classes="muted"
                                Text="{Binding SolverTest}"
                                IsVisible="{Binding SolverTest, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            />
                            <TextBlock
                                Text="Mirror preference (comma-separated: FileDitch, GoFile, MegaDb, BuzzHeavier)"
                                Classes="muted"
                                TextWrapping="Wrap"
                            />
                            <TextBox
                                Text="{Binding HosterOrder}"
                                FontFamily="{StaticResource Mono}"
                                FontSize="12"
                            />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock FontWeight="SemiBold" Text="Schedule and tray" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <StackPanel>
                                    <TextBlock
                                        Text="Check the catalog every (minutes)"
                                        Classes="muted"
                                    />
                                    <NumericUpDown
                                        Value="{Binding CheckIntervalMinutes}"
                                        Minimum="5"
                                        Maximum="1440"
                                        Width="160"
                                    />
                                </StackPanel>
                            </StackPanel>
                            <ToggleSwitch
                                IsChecked="{Binding Autostart}"
                                OnContent="Start with the system (hidden in tray)"
                                OffContent="Don't start with the system"
                            />
                            <ToggleSwitch
                                IsChecked="{Binding StartHidden}"
                                OnContent="Start hidden in the tray"
                                OffContent="Show the window on start"
                            />
                            <ToggleSwitch
                                IsChecked="{Binding ShortcutMenu}"
                                OnContent="Add installed games to the app menu"
                                OffContent="No app menu entries for games"
                            />
                            <ToggleSwitch
                                IsChecked="{Binding ShortcutDesktop}"
                                OnContent="Put a shortcut for each game on the desktop"
                                OffContent="No desktop shortcuts for games"
                            />
                            <ToggleSwitch
                                IsChecked="{Binding NotifyNewGames}"
                                OnContent="Notify when new games are posted"
                                OffContent="Only notify about my games"
                            />
                            <Button
                                Classes="quiet"
                                Content="Send a test notification"
                                Command="{Binding TestNotificationCommand}"
                                HorizontalAlignment="Left"
                            />
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="On this machine" />
                            <TextBlock Classes="mono muted" Text="{Binding VersionLine}" />
                            <TextBlock
                                Classes="mono muted"
                                Text="{Binding ToolsLine}"
                                TextWrapping="Wrap"
                            />
                            <TextBlock Classes="mono muted" Text="{Binding SecretsLine}" />
                            <DockPanel>
                                <Button
                                    DockPanel.Dock="Right"
                                    Classes="quiet"
                                    Content="Open"
                                    Command="{Binding OpenConfigDirCommand}"
                                />
                                <TextBlock
                                    Classes="mono muted"
                                    Text="{Binding ConfigDir}"
                                    VerticalAlignment="Center"
                                />
                            </DockPanel>
                            <DockPanel>
                                <Button
                                    DockPanel.Dock="Right"
                                    Classes="quiet"
                                    Content="Open"
                                    Command="{Binding OpenLogDirCommand}"
                                />
                                <TextBlock
                                    Classes="mono muted"
                                    Text="{Binding LogDir}"
                                    VerticalAlignment="Center"
                                />
                            </DockPanel>
                            <ToggleSwitch
                                IsChecked="{Binding VerboseLogging}"
                                OnContent="Verbose log (HTTP status codes, solver steps, page sizes)"
                                OffContent="Normal log (resolve, download, install, errors)"
                            />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Classes="muted"
                        Text="Changes save by themselves. Hoster order and FlareSolverr URL apply to the next job; library paths apply to new installs."
                        TextWrapping="Wrap"
                    />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.DataTemplates>

    <Panel>
        <Grid ColumnDefinitions="208,*">
            <!-- Nav rail -->
            <Border
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,1,0"
            >
                <DockPanel Margin="12,18,12,14">
                    <StackPanel
                        DockPanel.Dock="Top"
                        Margin="8,0,0,18"
                        Orientation="Horizontal"
                        Spacing="10"
                    >
                        <Image
                            Source="avares://steamrip-desktop/Assets/app.png"
                            Width="22"
                            Height="22"
                        />
                        <TextBlock
                            Text="SteamRIP"
                            FontWeight="SemiBold"
                            FontSize="15"
                            VerticalAlignment="Center"
                        />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse
                                Classes="dot"
                                Fill="{StaticResource Green}"
                                IsVisible="{Binding SolverHealthy}"
                            />
                            <Ellipse
                                Classes="dot"
                                Fill="{StaticResource Red}"
                                IsVisible="{Binding !SolverHealthy}"
                            />
                            <TextBlock
                                Classes="muted"
                                FontSize="11"
                                Text="FlareSolverr"
                                ToolTip.Tip="{Binding SolverLine}"
                            />
                        </StackPanel>
                        <TextBlock
                            Classes="muted"
                            FontSize="11"
                            Text="{Binding SyncLine}"
                            TextWrapping="Wrap"
                        />
                        <Button
                            Classes="quiet"
                            Content="Sync now"
                            Command="{Binding SyncNowCommand}"
                            IsEnabled="{Binding !Syncing}"
                            HorizontalAlignment="Left"
                            Padding="10,4"
                            FontSize="12"
                        />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <Button
                            Classes="nav"
                            Content="Library"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Library"
                            Classes.active="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Library}"
                        />
                        <Button
                            Classes="nav"
                            Content="Browse"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Browse"
                            Classes.active="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Browse}"
                        />
                        <Button
                            Classes="nav"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Queue"
                            Classes.active="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Queue}"
                        >
                            <DockPanel>
                                <Border
                                    DockPanel.Dock="Right"
                                    Classes="pill amber"
                                    IsVisible="{Binding QueueCount}"
                                >
                                    <TextBlock FontSize="11" Text="{Binding QueueCount}" />
                                </Border>
                                <Border
                                    DockPanel.Dock="Right"
                                    Classes="pill"
                                    Margin="0,0,4,0"
                                    IsVisible="{Binding AttentionCount}"
                                >
                                    <TextBlock
                                        FontSize="11"
                                        Classes="red"
                                        Text="{Binding AttentionCount}"
                                    />
                                </Border>
                                <TextBlock Text="Queue" />
                            </DockPanel>
                        </Button>
                        <Button
                            Classes="nav"
                            Content="Activity"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Activity"
                            Classes.active="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Activity}"
                        />
                        <Button
                            Classes="nav"
                            Content="Settings"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Settings"
                            Classes.active="{Binding Section, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=Settings}"
                        />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding Current}" />
        </Grid>

        <!-- Toast, bottom right -->
        <Border
            Classes="toast"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,24,20"
            IsVisible="{Binding ToastVisible}"
        >
            <TextBlock Text="{Binding Toast}" />
        </Border>

        <!-- Launch options side sheet: an overlay over the whole window so every field fits and scrolls -->
        <Panel IsVisible="{Binding IsEditing}">
            <Button
                Classes="backdrop"
                Command="{Binding CloseEditorCommand}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
            />
            <Border Classes="sheet" HorizontalAlignment="Right" Width="600">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,20,20,12">
                        <StackPanel>
                            <TextBlock Classes="eyebrow" Text="LAUNCH OPTIONS" />
                            <TextBlock
                                Classes="h1"
                                Text="{Binding Editing.Name, FallbackValue=''}"
                                TextTrimming="CharacterEllipsis"
                            />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Classes="quiet"
                            Content="Close"
                            Command="{Binding CloseEditorCommand}"
                            VerticalAlignment="Top"
                        />
                    </Grid>
                    <ScrollViewer>
                        <StackPanel Spacing="8" Margin="24,0,24,24" DataContext="{Binding Editing}">
                            <TextBlock Classes="eyebrow" Text="EXECUTABLE" />
                            <ComboBox
                                ItemsSource="{Binding Exes}"
                                SelectedItem="{Binding SelectedExe}"
                                HorizontalAlignment="Stretch"
                                FontFamily="{StaticResource Mono}"
                                FontSize="12"
                            />
                            <TextBlock Classes="eyebrow" Text="PROTON" Margin="0,6,0,0" />
                            <ComboBox
                                ItemsSource="{Binding Protons}"
                                SelectedItem="{Binding SelectedProton}"
                                HorizontalAlignment="Stretch"
                            />
                            <TextBlock Classes="eyebrow" Text="EXTRA ARGUMENTS" Margin="0,6,0,0" />
                            <TextBox
                                Text="{Binding LaunchArgs}"
                                PlaceholderText="-windowed -nosplash"
                                FontFamily="{StaticResource Mono}"
                                FontSize="12"
                            />
                            <TextBlock
                                Classes="eyebrow"
                                Text="TWEAKS · start at the Settings defaults; only what you change is saved for this game"
                                Margin="0,14,0,0"
                            />
                            <ContentControl Content="{Binding Launch}" />
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,14,0,0">
                                <Button
                                    Classes="quiet"
                                    Content="Game folder"
                                    Command="{Binding OpenFolderCommand}"
                                />
                                <Button
                                    Classes="quiet"
                                    Content="Prefix folder"
                                    Command="{Binding OpenPrefixCommand}"
                                />
                                <Button
                                    Classes="quiet"
                                    Content="Site page"
                                    Command="{Binding OpenPageCommand}"
                                />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>
    </Panel>
</Window>
