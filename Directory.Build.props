<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <InvariantGlobalization>true</InvariantGlobalization>

        <!-- Quality gates: .NET analyzers at the recommended level plus IDE style rules from .editorconfig,
         all treated as errors so `dotnet build` is the check. Whitespace is CSharpier's job (see .csharpierrc.yaml). -->
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Needed for IDE0005 (unused usings) to run at build; CS1591 is silenced in .editorconfig. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
</Project>
