#!/usr/bin/env sh
# Formats staged C#/AXAML with CSharpier and re-stages them, then builds with analyzers (warnings are errors).
# Install once per clone:  git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.cs' '*.axaml' || true)
if [ -n "$staged" ]; then
  dotnet tool restore >/dev/null
  # shellcheck disable=SC2086
  dotnet csharpier format $staged
  # shellcheck disable=SC2086
  git add $staged
fi

if git diff --cached --name-only | grep -Eq '\.(cs|axaml|csproj|props|editorconfig)$'; then
  dotnet build --nologo -v quiet
fi
